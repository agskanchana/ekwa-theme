{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"name": "acf/ekwa-section",
	"title": "EKWA Section",
	"description": "A full-width section container with background options and inner blocks support",
	"category": "ekwa-blocks",
	"icon": "layout",
	"keywords": ["section", "container", "wrapper", "inner blocks"],
	"acf": {
		"mode": "preview",
		"renderTemplate": "block.php"
	},
	"supports": {
		"align": ["wide", "full"],
		"anchor": true,
		"className": true,
		"jsx": true
	},
	"example": {
		"attributes": {
			"mode": "preview",
			"data": {
				"background_color": "#f5f5f5"
			}
		}
	}
}
