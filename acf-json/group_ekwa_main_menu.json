{
    "key": "group_ekwa_main_menu",
    "title": "EKWA Main Menu Settings",
    "fields": [
        {
            "key": "field_breakpoint",
            "label": "Mobile Breakpoint (px)",
            "name": "breakpoint",
            "type": "number",
            "instructions": "Width below which mobile menu is shown (default: 1154px)",
            "required": 0,
            "default_value": 1154,
            "min": 320,
            "max": 1920,
            "step": 1
        },
        {
            "key": "field_show_icons",
            "label": "Show Dropdown Icons",
            "name": "show_icons",
            "type": "true_false",
            "instructions": "Show arrow icons next to menu items with submenus",
            "required": 0,
            "default_value": 1,
            "ui": 1
        },
        {
            "key": "field_two_columns",
            "label": "Two Column Submenu",
            "name": "two_columns",
            "type": "true_false",
            "instructions": "Display submenu in two columns (requires Sub Menu Class if only specific items)",
            "required": 0,
            "default_value": 0,
            "ui": 1
        },
        {
            "key": "field_sub_menu_class",
            "label": "Sub Menu Class",
            "name": "sub_menu_class",
            "type": "text",
            "instructions": "CSS class for parent items that should have two-column submenus (leave empty for all)",
            "required": 0,
            "conditional_logic": [
                [
                    {
                        "field": "field_two_columns",
                        "operator": "==",
                        "value": "1"
                    }
                ]
            ]
        },
        {
            "key": "field_tab_desktop",
            "label": "Desktop Styling",
